model User {
  id            String         @id @default(uuid())
  name          String?
  email         String         @unique
  password      String?
  oauthId       String?        @unique
  provider      String?         // 'google', 'github', ...
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  conversations Conversation[]
  codingSessions CodingSession[]
  feedbacks      Feedback[]
  systemEvents   SystemEvent[]
  roadmaps       Roadmap[]

  // Achievement System Fields
  xp                     Int                  @default(0)
  lifetimeTasksCompleted Int                  @default(0)
  lifetimeProblemsSolved Int                  @default(0)
  lifetimeProjectsBuilt  Int                  @default(0)
  lifetimeLearningMinutes Int                  @default(0)

  // Achievement System Relations
  achievements           AchievementProgress[]
  badges                 Badge[]
  timelineEvents         TimelineEvent[]
  mentorRecognitions     MentorRecognition[]
  milestoneCelebrations  MilestoneCelebration[]
  xpTransactions         XPTransaction[]
  showcases              UserAchievementShowcase[]
  monthlyRecaps          MonthlyRecap[]
  journeySummaries       JourneySummary[]
  timeCapsules           TimeCapsule[]
}

model Conversation {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?   @default("New Chat")
  visibility String    @default("private") // optional: 'private'|'shared'
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages   Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           String    // "system" | "user" | "assistant" | "tool"
  content        String    // the actual text
  status         String?   // "complete" | "streaming" | "failed"
  parentId       String?   // optional: if this message replies to another message
  tokensUsed     Int?      // optional token accounting for this message/response
  metadata       Json?     // optional misc (tool output, source, etc.)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Problem {
  id                 String          @id @default(uuid())
  title              String
  slug               String          @unique
  difficulty         String          // "Easy" | "Medium" | "Hard"
  description        String          @db.Text
  constraints        String[]        // String array for PostgreSQL constraints
  category           String
  topicTags          String[]
  boilerplate        Json            // Keyed by language: { "python": "...", "javascript": "...", ... }
  difficultyEstimate String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  testCases          TestCase[]
  sessions           CodingSession[]
}

model TestCase {
  id             String   @id @default(uuid())
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String   @db.Text
  expectedOutput String   @db.Text
  isHidden       Boolean  @default(false)
}

model CodingSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  mode        String   // "Guided Practice" | "Real Interview" | "Timed Contest" | "Debugging Mode" | "Optimization Challenge"
  language    String   // "python" | "javascript" | "typescript" | "java" | "cpp"
  progress    Int      @default(0)
  codeDraft   String   @default("") @db.Text
  chatHistory Json     @default("[]") // Array of chat messages
  codyMemory  Json?    // Hints used count, repeated mistakes, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]
  reviews     InterviewReview[]
}

model Submission {
  id              String        @id @default(uuid())
  sessionId       String
  session         CodingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  code            String        @db.Text
  language        String
  status          String        // "ACCEPTED" | "WRONG_ANSWER" | "COMPILE_ERROR" | "RUNTIME_ERROR" | "TIME_LIMIT_EXCEEDED"
  runtime         Int?          // runtime in milliseconds
  passedCount     Int
  totalCount      Int
  executionSource String?       @default("PISTON")
  executionReliable Boolean?      @default(true)
  createdAt       DateTime      @default(now())
}

model InterviewReview {
  id             String        @id @default(uuid())
  sessionId      String        @unique
  session        CodingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore   Float
  scores         Json          // Readability, Optimization, Edge cases, etc.
  summary        String        @db.Text
  strengths      String[]
  weaknesses     String[]
  roadmapInsights Json?
  createdAt      DateTime      @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  prompt    String   // e.g. "Cody Hint Helpfulness" | "AI Review Accuracy"
  source    String   // "cody_hint", "ai_review", "weekly_coach", "problem_recommendation"
  rating    String   // "HELPFUL" | "UNHELPFUL" or rating scale
  comment   String?  @db.Text
  createdAt DateTime @default(now())
}

model SystemEvent {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType    String   // "session_started" | "submission_attempted" | "hint_requested" | "optimization_improved" | "problem_completed" | "review_generated"
  eventVersion String   @default("v1")
  sessionId    String?
  metadata     Json?    // custom metadata payload
  createdAt    DateTime @default(now())
}

model Roadmap {
  id                    String      @id @default(uuid())
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapVersion        String      @default("v1")
  title                 String
  description           String      @db.Text
  currentLevel          String      // "Beginner" | "Intermediate" | "Advanced"
  focusArea             String      // "Frontend" | "Backend" | "Full Stack" | "DSA" | "AI/ML" | "DevOps"
  weeklyHours           Int         @default(5)
  learningStyle         String?     @default("Project-based")
  targetDeadline        DateTime?
  totalTasks            Int         @default(0)
  completedTasks        Int         @default(0)
  progressPercentage    Float       @default(0.0)
  currentFocus          String?
  aiInsights            String[]
  recommendedArenaTopics String[]
  status                String      @default("active") // "active" | "paused" | "completed" | "archived"
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  phases                Phase[]
}

model Phase {
  id          String    @id @default(uuid())
  roadmapId   String
  roadmap     Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  title       String
  duration    String    // e.g. "Week 1-2"
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  milestones  Milestone[]
}

model Milestone {
  id          String    @id @default(uuid())
  phaseId     String
  phase       Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks       RoadmapTask[]
}

model RoadmapTask {
  id             String    @id @default(uuid())
  milestoneId    String
  milestone      Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  title          String
  description    String?   @db.Text
  isCompleted    Boolean   @default(false)
  durationMins   Int       @default(30)
  arenaTopic     String?   // optional: e.g. "Dynamic Programming"
  estimatedDays  Int       @default(1)
  order          Int       @default(0)
  sourceType     String    @default("roadmap") // "roadmap" | "coding_arena" | "ai_review" | "manual"
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Achievement System Enums
enum AchievementCategory {
  STREAK
  ROADMAP
  CODING
  PROJECT
  COMMUNITY
  SPECIAL
  LEARNING
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum AchievementVisibility {
  PUBLIC
  HIDDEN
}

enum TimelineEventType {
  ACHIEVEMENT
  ROADMAP
  PROJECT
  STREAK
  LEVEL_UP
  CODING
}

enum XPTransactionSource {
  TASK_COMPLETED
  ACHIEVEMENT_UNLOCKED
  BADGE_EVOLUTION
  STREAK
  ROADMAP_COMPLETION
}

// Achievement System Models
model Achievement {
  id             String                @id @default(uuid())
  title          String                @unique
  description    String
  category       AchievementCategory
  rarity         AchievementRarity
  visibility     AchievementVisibility @default(PUBLIC)
  icon           String                // Emoji or Lucide icon name
  xpReward       Int                   @default(0)
  maxProgress    Int                   @default(1)
  hiddenCriteria Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  progressions   AchievementProgress[]
  showcases      UserAchievementShowcase[]
}

model AchievementProgress {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId   String
  achievement     Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  currentProgress Int         @default(0)
  isUnlocked      Boolean     @default(false)
  unlockedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, achievementId])
  @@index([userId])
}

model Badge {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeType    String   // "STREAK" | "CODING" | "BUILDER"
  currentStage Int      @default(1) // stageOrder (1 to 5)
  unlockedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  showcases    UserAchievementShowcase[]

  @@unique([userId, badgeType])
  @@index([userId])
}

model BadgeStage {
  id          String    @id @default(uuid())
  badgeType   String    // "STREAK" | "CODING" | "BUILDER"
  stageOrder  Int       // 1, 2, 3, 4, 5
  name        String    // e.g. "Spark", "Flame", etc.
  requirement Float     // e.g. 3.0, 7.0, etc.
  xpReward    Int       @default(0)
  icon        String    // Emoji or Lucide icon name
  description String
  createdAt   DateTime  @default(now())

  @@unique([badgeType, stageOrder])
}

model TimelineEvent {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String
  icon          String
  category      String            // "STREAK" | "CODING" | "BUILDER" | ...
  type          TimelineEventType
  metadata      Json?             // Snapshot of metrics (XP, streak, stage)
  statsSnapshot Json?             // Precise stats at event time: { level, streak, tasks, problems }
  eventDate     DateTime          @default(now())
  createdAt     DateTime          @default(now())

  @@index([userId, eventDate])
}

model MentorRecognition {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message            String
  relatedAchievement String?  // Optional name of related achievement
  generatedAt        DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([userId])
}

model MilestoneCelebration {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementName String
  achievementIcon String
  xpEarned        Int
  statsSnapshot   Json     // { tasksCompleted: 47, projectsBuilt: 3, hoursInvested: 23 }
  mentorMessage   String
  isCelebrated    Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, isCelebrated])
}

model XPTransaction {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  source    XPTransactionSource
  metadata  Json?               // e.g. { taskId: "...", achievementId: "..." }
  createdAt DateTime            @default(now())

  @@index([userId])
}

enum ShowcaseItemType {
  ACHIEVEMENT
  BADGE
}

model UserAchievementShowcase {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          ShowcaseItemType
  achievementId String?
  achievement   Achievement?     @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  badgeId       String?
  badge         Badge?           @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  displayOrder  Int              @default(0)
  createdAt     DateTime         @default(now())

  @@index([userId, displayOrder])
}

enum JourneySummaryType {
  MONTHLY
  MILESTONE
  ROADMAP_COMPLETION
}

model JourneySummary {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary             String             @db.Text
  strongestHabit      String
  biggestGrowthArea   String
  proudestAchievement String
  summaryType         JourneySummaryType
  periodStart         DateTime?
  periodEnd           DateTime?
  generatedAt         DateTime           @default(now())

  @@index([userId])
}

model MonthlyRecap {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month                Int      // 1-12
  year                 Int
  tasksCompleted       Int      @default(0)
  problemsSolved       Int      @default(0)
  hoursLearned         Float    @default(0.0)
  achievementsUnlocked Int      @default(0)
  milestonesCompleted  Int      @default(0)
  mentorSummary        String?  @db.Text
  startSnapshot        Json?    // { level: Int, streak: Int, tasks: Int, problems: Int }
  endSnapshot          Json?    // { level: Int, streak: Int, tasks: Int, problems: Int }
  createdAt            DateTime @default(now())

  @@unique([userId, month, year])
  @@index([userId])
}

model TimeCapsule {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message          String    @db.Text
  milestoneContext String
  createdAt        DateTime  @default(now())
  revealAt         DateTime
  revealedAt       DateTime? // When background reflection is generated
  openedAt         DateTime? // When user clicks to open
  mentorReflection String?   @db.Text
  statsSnapshot    Json?     // { level: Int, streak: Int, tasks: Int, problems: Int }

  @@index([userId])
}



